[
  {
    "name": "theme_info",
    "theme_name": "Arthur's Creatives",
    "theme_version": "1.0.0",
    "theme_author": "Velo Website Development LLC",
    "theme_documentation_url": "https://help.shopify.com/manual/online-store/themes",
    "theme_support_url": "https://support.shopify.com/"
  },
  {
    "name": "Typography",
    "settings": [
      {
        "type": "font_picker",
        "id": "type_primary_font",
        "default": "work_sans_n4",
        "label": "Body font"
      },
      {
        "type": "font_picker",
        "id": "type_heading_font",
        "default": "playfair_display_n7",
        "label": "Heading font"
      }
    ]
  },
  {
    "name": "Layout",
    "settings": [
      {
        "type": "select",
        "id": "max_page_width",
        "label": "Maximum page width",
        "options": [
          { "value": "80rem", "label": "Standard" },
          { "value": "90rem", "label": "Wide" },
          { "value": "100rem", "label": "Extra wide" }
        ],
        "default": "90rem"
      },
      {
        "type": "range",
        "id": "min_page_margin",
        "min": 12,
        "max": 64,
        "step": 2,
        "unit": "px",
        "label": "Page margin",
        "default": 24
      },
      {
        "type": "range",
        "id": "card_corner_radius",
        "min": 0,
        "max": 32,
        "step": 2,
        "unit": "px",
        "label": "Card corner radius",
        "default": 18
      },
      {
        "type": "range",
        "id": "button_corner_radius",
        "min": 0,
        "max": 40,
        "step": 2,
        "unit": "px",
        "label": "Button corner radius",
        "default": 6
      },
      {
        "type": "range",
        "id": "input_corner_radius",
        "min": 0,
        "max": 20,
        "step": 1,
        "unit": "px",
        "label": "Input corner radius",
        "default": 6
      }
    ]
  },
  {
    "name": "Brand colors",
    "settings": [
      { "type": "color", "id": "background_color", "default": "#F7F1E8", "label": "Page background" },
      { "type": "color", "id": "surface_color", "default": "#FFFDFC", "label": "Card background" },
      { "type": "color", "id": "foreground_color", "default": "#180D0F", "label": "Primary text" },
      { "type": "color", "id": "muted_color", "default": "#705F62", "label": "Secondary text" },
      { "type": "color", "id": "burgundy_color", "default": "#4B0F1B", "label": "Burgundy" },
      { "type": "color", "id": "gold_color", "default": "#C9A24D", "label": "Antique gold" },
      { "type": "color", "id": "border_color", "default": "#DFD1C4", "label": "Borders" }
    ]
  }
]
